ned['video_id'].duplicated().sum())\n","\n","combined.to_csv('data_combined.csv', index=False)\n","print(\"\\nSaved to data_combined.csv\")"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"kGj-PWwMgtvK","executionInfo":{"status":"ok","timestamp":1788225034008,"user_tz":240,"elapsed":690,"user":{"displayName":"Joseph Caliendo","userId":"14439372009265182804"}},"outputId":"dd656d44-2af5-4c89-d90d-ca14399890bd"},"execution_count":7,"outputs":[{"output_type":"stream","name":"stdout","text":["Combined shape: (17933, 13)\n","Total unique channels: 93\n","\n","Videos per source:\n","source\n","extension_68    12933\n","original_25      5000\n","Name: count, dtype: int64\n","\n","Videos per category:\n","source        research_category\n","extension_68  Documentary          2825\n","              Education            2908\n","              Entertainment        3200\n","              Gaming               3200\n","              News                  800\n","original_25   Documentary          1000\n","              Education            1000\n","              Entertainment        1000\n","              Gaming               1000\n","              News                 1000\n","dtype: int64\n","\n","Duplicate video_ids (sanity check -- should be 0):\n","0\n","\n","Saved to data_combined.csv\n"]}]},{"cell_type":"code","source":["\"\"\"\n","ML pipeline (not just statistics): per-age-bucket models for\n","log(views) - log(subscribers), validated with channel-grouped\n","cross-validation so no channel appears in both train and test.\n","\n","Compares two things per bucket:\n","  1. BASELINE: predict the bucket's mean log_ratio for every video\n","  2. MODEL: Ridge regression on title features\n","     (word_count, avg_word_length, pct_caps, has_allcaps_word)\n","\n","If the model doesn't beat the baseline on held-out folds, that's a\n","real, honest result -- not a reason to hide it.\n","\n","Run yourself:  python3 ml_pipeline.py\n","\"\"\"\n","\n","import pandas as pd\n","import numpy as np\n","from sklearn.model_selection import GroupKFold\n","from sklearn.linear_model import Ridge\n","from sklearn.dummy import DummyRegressor\n","from sklearn.metrics import r2_score, mean_absolute_error\n","from sklearn.preprocessing import StandardScaler\n","\n","# ---------- 1. Load & compute target ----------\n","df = pd.read_csv('data_combined.csv')\n","df = df[df['view_count'] > 0].copy()\n","\n","df['published_at'] = pd.to_datetime(df['published_at'])\n","now = pd.Timestamp('2026-08-30', tz='UTC')\n","df['days_since_upload'] = (now - df['published_at']).dt.days\n","\n","df['log_ratio'] = np.log(df['view_count']) - np.log(df['channel_subscriber_count'])\n","\n","# ---------- 2. Age buckets (same as before) ----------\n","bins = [0, 30, 180, 360, 720, np.inf]\n","labels = ['<30d', '30-180d', '180-360d', '360-720d', '720d+']\n","df['age_bucket'] = pd.cut(df['days_since_upload'], bins=bins, labels=labels)\n","\n","# ---------- 3. Title features (same 4 as before) ----------\n","t = df['title'].astype(str)\n","\n","df['title_len'] = t.str.len()\n","df['word_count'] = t.str.split().str.len()\n","df['avg_word_length'] = df['title_len'] / df['word_count'].replace(0, np.nan)\n","df['avg_word_length'] = df['avg_word_length'].fillna(0)\n","\n","def pct_caps(s):\n","    letters = [c for c in s if c.isalpha()]\n","    return sum(1 for c in letters if c.isupper()) / len(letters) if letters else 0.0\n","df['pct_caps'] = t.apply(pct_caps)\n","\n","def has_allcaps_word(s):\n","    words = s.split()\n","    return int(any(w.isalpha() and w.isupper() and len(w) > 1 for w in words))\n","df['has_allcaps_word'] = t.apply(has_allcaps_word)\n","\n","FEATURES = ['word_count', 'avg_word_length', 'pct_caps', 'has_allcaps_word']\n","\n","# ---------- 4. Channel-grouped CV per bucket: baseline vs. model ----------\n","N_SPLITS = 5  # with 93 channels, ~18-19 channels held out per fold\n","\n","results = []\n","\n","for bucket in labels:\n","    sub = df[df['age_bucket'] == bucket].copy()\n","    n_channels = sub['channel_title'].nunique()\n","\n","    if n_channels < N_SPLITS:\n","        print(f\"Skipping {bucket}: only {n_channels} channels, too few for {N_SPLITS}-fold CV\")\n","        continue\n","\n","    X = sub[FEATURES].values\n","    y = sub['log_ratio'].values\n","    groups = sub['channel_title'].values\n","\n","    gkf = GroupKFold(n_splits=N_SPLITS)\n","\n","    baseline_r2, baseline_mae = [], []\n","    model_r2, model_mae = [], []\n","\n","    for train_idx, test_idx in gkf.split(X, y, groups):\n","        X_train, X_test = X[train_idx], X[test_idx]\n","        y_train, y_test = y[train_idx], y[test_idx]\n","\n","        # Baseline: predict training mean for every test video\n","        dummy = DummyRegressor(strategy='mean')\n","        dummy.fit(X_train, y_train)\n","        base_preds = dummy.predict(X_test)\n","        baseline_r2.append(r2_score(y_test, base_preds))\n","        baseline_mae.append(mean_absolute_error(y_test, base_preds))\n","\n","        # Model: standardize within training fold only (no leakage), then Ridge\n","        scaler = StandardScaler()\n","        X_train_scaled = scaler.fit_transform(X_train)\n","        X_test_scaled = scaler.transform(X_test)\n","\n","        ridge = Ridge(alpha=1.0)\n","        ridge.fit(X_train_scaled, y_train)\n","        model_preds = ridge.predict(X_test_scaled)\n","        model_r2.append(r2_score(y_test, model_preds))\n","        model_mae.append(mean_absolute_error(y_test, model_preds))\n","\n","    results.append({\n","        'bucket': bucket,\n","        'n_videos': len(sub),\n","        'n_channels': n_channels,\n","        'baseline_r2_mean': np.mean(baseline_r2),\n","        'baseline_r2_std': np.std(baseline_r2),\n","        'model_r2_mean': np.mean(model_r2),\n","        'model_r2_std': np.std(model_r2),\n","        'baseline_mae_mean': np.mean(baseline_mae),\n","        'model_mae_mean': np.mean(model_mae),\n","        'r2_improvement': np.mean(model_r2) - np.mean(baseline_r2),\n","    })\n","\n","results_df = pd.DataFrame(results)\n","print(\"\\n\" + \"=\"*100)\n","print(\"HELD-OUT VALIDATION RESULTS (channel-grouped CV, no channel leakage)\")\n","print(\"=\"*100)\n","print(results_df.to_string(index=False))\n","\n","results_df.to_csv('ml_validation_results.csv', index=False)\n","print(\"\\nSaved to ml_validation_results.csv\")\n","\n","print(\"\\n\" + \"=\"*100)\n","print(\"INTERPRETATION GUIDE\")\n","print(\"=\"*100)\n","print(\"\"\"\n","- If model_r2_mean > baseline_r2_mean: title features add real predictive\n","  power beyond just knowing the bucket average, on UNSEEN channels.\n","- If model_r2_mean <= baseline_r2_mean: title features don't generalize --\n","  the earlier full-sample regression coefficients may reflect in-sample\n","  patterns that don't hold on new channels. This is a legitimate, honest\n","  finding, not a failure.\n","- Negative R2 (for either baseline or model) means worse than predicting\n","  the training mean -- can happen with small/noisy folds, especially in\n","  buckets with fewer channels.\n","- Compare r2_improvement across buckets: even a small positive improvement\n","  that's consistent across buckets is more trustworthy than a single large\n","  improvement in only one bucket.\n","\"\"\")"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"QXI61oSIhk1z","executionInfo":{"status":"ok","timestamp":1788225155055,"user_tz":240,"elapsed":6385,"user":{"displayName":"Joseph Caliendo","userId":"14439372009265182804"}},"outputId":"c3d26a4d-5e63-4181-b07d-222672c2012f"},"execution_count":8,"outputs":[{"output_type":"stream","name":"stdout","text":["\n","====================================================================================================\n","HELD-OUT VALIDATION RESULTS (channel-grouped CV, no channel leakage)\n","====================================================================================================\n","  bucket  n_videos  n_channels  baseline_r2_mean  baseline_r2_std  model_r2_mean  model_r2_std  baseline_mae_mean  model_mae_mean  r2_improvement\n","    <30d      2598          80         -0.098745         0.076418      -0.075703      0.205883           1.566823        1.516924        0.023043\n"," 30-180d      4492          82         -0.026823         0.020131      -0.062384      0.102612           1.462910        1.455667       -0.035561\n","180-360d      2525          69         -0.185334         0.169528      -0.274933      0.133393           1.636804        1.670941       -0.089598\n","360-720d      2842          59         -0.177824         0.114312      -0.192620      0.170484           1.292276        1.310508       -0.014797\n","   720d+      5150          51         -0.021965         0.020384      -0.047563      0.056311           1.079698        1.089622       -0.025598\n","\n","Saved to ml_validation_results.csv\n","\n","====================================================================================================\n","INTERPRETATION GUIDE\n","====================================================================================================\n","\n","- If model_r2_mean > baseline_r2_mean: title features add real predictive\n","  power beyond just knowing the bucket average, on UNSEEN channels.\n","- If model_r2_mean <= baseline_r2_mean: title features don't generalize --\n","  the earlier full-sample regression coefficients may reflect in-sample\n","  patterns that don't hold on new channels. This is a legitimate, honest\n","  finding, not a failure.\n","- Negative R2 (for either baseline or model) means worse than predicting\n","  the training mean -- can happen with small/noisy folds, especially in\n","  buckets with fewer channels.\n","- Compare r2_improvement across buckets: even a small positive improvement\n","  that's consistent across buckets is more trustworthy than a single large\n","  improvement in only one bucket.\n","\n"]}]},{"cell_type":"code","source":["\"\"\"\n","Variance decomposition: how much of the variance in log(views)-log(subs)\n","is between-channel vs. within-channel?\n","\n","This explains WHY title features failed to generalize in the held-out\n","validation: if most variance is between-channel, no per-video feature\n","(title style or otherwise) can explain much of it for a channel the\n","model has never seen.\n","\n","Computed overall and per age bucket, using a one-way ANOVA decomposition:\n","  total variance = between-channel variance + within-channel variance\n","  ICC (intraclass correlation) = between-channel variance / total variance\n","  ICC close to 1 -> channel identity dominates\n","  ICC close to 0 -> videos within a channel vary as much as across channels\n","\n","Run yourself:  python3 variance_decomposition.py\n","\"\"\"\n","\n","import pandas as pd\n","import numpy as np\n","\n","df = pd.read_csv('data_combined.csv')\n","df = df[df['view_count'] > 0].copy()\n","\n","df['published_at'] = pd.to_datetime(df['published_at'])\n","now = pd.Timestamp('2026-08-30', tz='UTC')\n","df['days_since_upload'] = (now - df['published_at']).dt.days\n","df['log_ratio'] = np.log(df['view_count']) - np.log(df['channel_subscriber_count'])\n","\n","bins = [0, 30, 180, 360, 720, np.inf]\n","labels = ['<30d', '30-180d', '180-360d', '360-720d', '720d+']\n","df['age_bucket'] = pd.cut(df['days_since_upload'], bins=bins, labels=labels)\n","\n","\n","def variance_decomposition(sub_df, value_col='log_ratio', group_col='channel_title'):\n","    \"\"\"One-way ANOVA-style decomposition of variance into\n","    between-group and within-group components.\"\"\"\n","    grand_mean = sub_df[value_col].mean()\n","    n_total = len(sub_df)\n","\n","    group_stats = sub_df.groupby(group_col)[value_col].agg(['mean', 'count'])\n","\n","    # Between-group sum of squares: sum over groups of n_g * (group_mean - grand_mean)^2\n","    ss_between = (group_stats['count'] * (group_stats['mean'] - grand_mean) ** 2).sum()\n","\n","    # Within-group sum of squares: sum over all rows of (value - own group's mean)^2\n","    merged = sub_df.merge(group_stats['mean'].rename('group_mean'), on=group_col)\n","    ss_within = ((merged[value_col] - merged['group_mean']) ** 2).sum()\n","\n","    ss_total = ss_between + ss_within\n","\n","    var_between = ss_between / n_total\n","    var_within = ss_within / n_total\n","    icc = ss_between / ss_total if ss_total > 0 else np.nan\n","\n","    return {\n","        'n_videos': n_total,\n","        'n_channels': sub_df[group_col].nunique(),\n","        'total_variance': sub_df[value_col].var(),\n","        'between_channel_variance': var_between,\n","        'within_channel_variance': var_within,\n","        'icc_pct_between': icc * 100,\n","    }\n","\n","\n","print(\"=\"*90)\n","print(\"OVERALL (all age buckets combined)\")\n","print(\"=\"*90)\n","overall = variance_decomposition(df)\n","for k, v in overall.items():\n","    print(f\"  {k}: {v:.4f}\" if isinstance(v, float) else f\"  {k}: {v}\")\n","\n","print(\"\\n\" + \"=\"*90)\n","print(\"PER AGE BUCKET\")\n","print(\"=\"*90)\n","\n","results = []\n","for bucket in labels:\n","    sub = df[df['age_bucket'] == bucket]\n","    decomp = variance_decomposition(sub)\n","    decomp['age_bucket'] = bucket\n","    results.append(decomp)\n","    print(f\"\\n--- {bucket} ---\")\n","    for k, v in decomp.items():\n","        if k != 'age_bucket':\n","            print(f\"  {k}: {v:.4f}\" if isinstance(v, float) else f\"  {k}: {v}\")\n","\n","results_df = pd.DataFrame(results)\n","results_df.to_csv('variance_decomposition_results.csv', index=False)\n","print(\"\\nSaved to variance_decomposition_results.csv\")\n","\n","print(\"\\n\" + \"=\"*90)\n","print(\"INTERPRETATION GUIDE\")\n","print(\"=\"*90)\n","print(\"\"\"\n","icc_pct_between = the percentage of total variance in log_ratio explained\n","just by knowing WHICH CHANNEL a video is from (nothing else -- not title,\n","not age, not anything else).\n","\n","This is the ceiling on how much any per-video feature (title style\n","included) could possibly explain for a video from a NEW, unseen channel:\n","whatever fraction is between-channel is fundamentally about channel\n","identity, not about the video itself. Only the within-channel fraction\n","is even theoretically available for title features to explain -- and the\n","held-out validation already showed title features barely explain even\n","that portion.\n","\"\"\")"],"metadata":{"id":"DqcoSxnxixce","executionInfo":{"status":"ok","timestamp":1788225464698,"user_tz":240,"elapsed":829,"user":{"displayName":"Joseph Caliendo","userId":"14439372009265182804"}},"outputId":"1feccf0a-357c-4ca4-a75b-effab10df5ae","colab":{"base_uri":"https://localhost:8080/"}},"execution_count":9,"outputs":[{"output_type":"stream","name":"stdout","text":["==========================================================================================\n","OVERALL (all age buckets combined)\n","==========================================================================================\n","  n_videos: 17920\n","  n_channels: 93\n","  total_variance: 4.7895\n","  between_channel_variance: 3.5955\n","  within_channel_variance: 1.1937\n","  icc_pct_between: 75.0759\n","\n","==========================================================================================\n","PER AGE BUCKET\n","==========================================================================================\n","\n","--- <30d ---\n","  n_videos: 2598\n","  n_channels: 80\n","  total_variance: 3.6455\n","  between_channel_variance: 2.1413\n","  within_channel_variance: 1.5028\n","  icc_pct_between: 58.7603\n","\n","--- 30-180d ---\n","  n_videos: 4492\n","  n_channels: 82\n","  total_variance: 3.6398\n","  between_channel_variance: 2.6508\n","  within_channel_variance: 0.9882\n","  icc_pct_between: 72.8450\n","\n","--- 180-360d ---\n","  n_videos: 2525\n","  n_channels: 69\n","  total_variance: 4.0024\n","  between_channel_variance: 3.1436\n","  within_channel_variance: 0.8572\n","  icc_pct_between: 78.5744\n","\n","--- 360-720d ---\n","  n_videos: 2842\n","  n_channels: 59\n","  total_variance: 2.4664\n","  between_channel_variance: 1.5243\n","  within_channel_variance: 0.9412\n","  icc_pct_between: 61.8256\n","\n","--- 720d+ ---\n","  n_videos: 5150\n","  n_channels: 51\n","  total_variance: 1.8095\n","  between_channel_variance: 0.8359\n","  within_channel_variance: 0.9732\n","  icc_pct_between: 46.2060\n","\n","Saved to variance_decomposition_results.csv\n","\n","==========================================================================================\n","INTERPRETATION GUIDE\n","==========================================================================================\n","\n","icc_pct_between = the percentage of total variance in log_ratio explained\n","just by knowing WHICH CHANNEL a video is from (nothing else -- not title,\n","not age, not anything else).\n","\n","This is the ceiling on how much any per-video feature (title style\n","included) could possibly explain for a video from a NEW, unseen channel:\n","whatever fraction is between-channel is fundamentally about channel\n","identity, not about the video itself. Only the within-channel fraction\n","is even theoretically available for title features to explain -- and the\n","held-out validation already showed title features barely explain even\n","that portion.\n","\n"]}]}]}