{"nbformat":4,"nbformat_minor":0,"metadata":{"colab":{"provenance":[],"authorship_tag":"ABX9TyMB941kkb/5Q4Oaug5MN4Mq"},"kernelspec":{"name":"python3","display_name":"Python 3"},"language_info":{"name":"python"}},"cells":[{"cell_type":"code","source":["\"\"\"\n","Per-age-bucket OLS regression: title features -> log(views)-log(subs)\n","\n","Reduced to 4 objective, consistently-behaved features (dropped features\n","that flipped sign or were inconsistent across buckets in earlier runs):\n","  - word_count          : number of words in the title\n","  - avg_word_length     : title_len / word_count (de-correlated from word_count)\n","  - pct_caps            : % of letters that are uppercase\n","  - has_allcaps_word    : boolean, does the title contain >=1 fully-caps word\n","                           (replaces the noisy allcaps_word_ratio; kept\n","                           separate from pct_caps rather than merged, since\n","                           they had opposite signs -- a real, interpretable\n","                           contrast, not noise)\n","\n","Run this yourself:  python3 bucket_regression_v3.py\n","\"\"\"\n","\n","import pandas as pd\n","import numpy as np\n","import statsmodels.api as sm\n","from statsmodels.stats.outliers_influence import variance_inflation_factor\n","\n","# ---------- 1. Load & compute target ----------\n","df = pd.read_csv('youtube_titles_dataset (2) - youtube_titles_dataset (2) (1).csv')\n","df = df[df['view_count'] > 0].copy()\n","\n","df['published_at'] = pd.to_datetime(df['published_at'])\n","now = pd.Timestamp('2026-08-30', tz='UTC')\n","df['days_since_upload'] = (now - df['published_at']).dt.days\n","\n","df['log_ratio'] = np.log(df['view_count']) - np.log(df['channel_subscriber_count'])\n","\n","# ---------- 2. Age buckets ----------\n","bins = [0, 30, 180, 360, 720, np.inf]\n","labels = ['<30d', '30-180d', '180-360d', '360-720d', '720d+']\n","df['age_bucket'] = pd.cut(df['days_since_upload'], bins=bins, labels=labels)\n","\n","# ---------- 3. Reduced, objective title features ----------\n","t = df['title'].astype(str)\n","\n","df['title_len'] = t.str.len()\n","df['word_count'] = t.str.split().str.len()\n","df['avg_word_length'] = df['title_len'] / df['word_count'].replace(0, np.nan)\n","df['avg_word_length'] = df['avg_word_length'].fillna(0)\n","\n","def pct_caps(s):\n","    letters = [c for c in s if c.isalpha()]\n","    return sum(1 for c in letters if c.isupper()) / len(letters) if letters else 0.0\n","df['pct_caps'] = t.apply(pct_caps)\n","\n","def has_allcaps_word(s):\n","    words = s.split()\n","    return int(any(w.isalpha() and w.isupper() and len(w) > 1 for w in words))\n","df['has_allcaps_word'] = t.apply(has_allcaps_word)\n","\n","TITLE_FEATS = ['word_count', 'avg_word_length', 'pct_caps', 'has_allcaps_word']\n","\n","# ---------- 4. VIF check ----------\n","def compute_vif(X):\n","    vif_data = pd.DataFrame()\n","    vif_data['feature'] = X.columns\n","    vif_data['VIF'] = [variance_inflation_factor(X.values, i) for i in range(X.shape[1])]\n","    return vif_data\n","\n","# ---------- 5. Standardize + run OLS per bucket ----------\n","results = {}\n","\n","for bucket in labels:\n","    sub = df[df['age_bucket'] == bucket].copy()\n","\n","    X = sub[TITLE_FEATS].copy()\n","    X = (X - X.mean()) / X.std(ddof=0)\n","\n","    print(f\"\\n{'='*70}\")\n","    print(f\"VIF check — AGE BUCKET: {bucket}\")\n","    print(f\"{'='*70}\")\n","    print(compute_vif(X).sort_values('VIF', ascending=False))\n","\n","    X = sm.add_constant(X)\n","    y = sub['log_ratio']\n","\n","    model = sm.OLS(y, X, missing='drop').fit()\n","    results[bucket] = model\n","\n","    print(f\"\\n{'='*70}\")\n","    print(f\"AGE BUCKET: {bucket}   (n={len(sub)})\")\n","    print(f\"{'='*70}\")\n","    print(model.summary())\n","\n","# ---------- 6. Summary table ----------\n","print(f\"\\n{'='*70}\")\n","print(\"SUMMARY: features per bucket, ranked by |standardized coefficient|\")\n","print(f\"{'='*70}\")\n","for bucket, model in results.items():\n","    coefs = model.params.drop('const')\n","    pvals = model.pvalues.drop('const')\n","    summary_df = pd.DataFrame({'coef': coefs, 'p_value': pvals})\n","    summary_df = summary_df.reindex(summary_df['coef'].abs().sort_values(ascending=False).index)\n","    print(f\"\\n--- {bucket} ---\")\n","    print(summary_df.round(4))\n","\n","# Save\n","all_rows = []\n","for bucket, model in results.items():\n","    coefs = model.params.drop('const')\n","    pvals = model.pvalues.drop('const')\n","    for feat in coefs.index:\n","        all_rows.append({\n","            'age_bucket': bucket,\n","            'feature': feat,\n","            'coef': coefs[feat],\n","            'p_value': pvals[feat],\n","            'r_squared': model.rsquared,\n","            'n': int(model.nobs)\n","        })\n","pd.DataFrame(all_rows).to_csv('bucket_regression_results_v3.csv', index=False)\n","print(\"\\nSaved full results to bucket_regression_results_v3.csv\")"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"pMAbRtNSF6D7","executionInfo":{"status":"ok","timestamp":1788134875082,"user_tz":240,"elapsed":439,"user":{"displayName":"Joseph Caliendo","userId":"14439372009265182804"}},"outputId":"945b2124-4917-43e4-d7d0-cc9de0d3664b"},"execution_count":4,"outputs":[{"output_type":"stream","name":"stdout","text":["\n","======================================================================\n","VIF check — AGE BUCKET: <30d\n","======================================================================\n","            feature       VIF\n","2          pct_caps  1.449649\n","3  has_allcaps_word  1.294712\n","1   avg_word_length  1.267813\n","0        word_count  1.216542\n","\n","======================================================================\n","AGE BUCKET: <30d   (n=1015)\n","======================================================================\n","                            OLS Regression Results                         