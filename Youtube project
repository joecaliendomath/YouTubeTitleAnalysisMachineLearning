ied IDs via\n","# the API itself (search.list), so there's no risk of a fabricated or\n","# incorrect ID string (which is what caused the earlier crash).\n","NEW_CHANNEL_NAMES = {\n","    \"Gaming\": [\n","        \"Game Grumps\", \"RTGame\", \"Vikkstar123\", \"Grian\", \"Typical Gamer\",\n","        \"CoryxKenshin\", \"DanTDM\", \"Jacksfilms\", \"GameXplain\", \"8-BitRyan\",\n","        \"Ludwig\", \"xQc\", \"Valkyrae\", \"Dream\", \"TommyInnit\", \"KSI\",\n","    ],\n","    \"Education\": [\n","        \"3Blue1Brown\", \"SciShow\", \"SmarterEveryDay\", \"Tom Scott\", \"Numberphile\",\n","        \"minutephysics\", \"PBS Space Time\", \"Ben Eater\", \"AsapSCIENCE\", \"Physics Girl\",\n","        \"Mark Rober\", \"The Organic Chemistry Tutor\", \"Practical Engineering\",\n","        \"It's Okay To Be Smart\", \"Two Minute Papers\", \"Domain of Science\",\n","    ],\n","    \"Documentary\": [\n","        \"Defunctland\", \"RealLifeLore\", \"ColdFusion\", \"Company Man\", \"PBS Eons\",\n","        \"Historia Civilis\", \"Business Casual\", \"Half as Interesting\", \"Neo\",\n","        \"Fascinating Horror\", \"Real Engineering\", \"Legal Eagle\", \"toldinstone\",\n","        \"Kings and Generals\", \"The Infographics Show\", \"Task & Purpose\",\n","    ],\n","    \"Entertainment\": [\n","        \"Saturday Night Live\", \"The Daily Show\", \"Corridor Crew\", \"Sidemen\", \"Watcher\",\n","        \"First We Feast\", \"Smosh\", \"React\", \"Screen Rant\", \"CollegeHumor\",\n","        \"Logan Paul\", \"Emma Chamberlain\", \"David Dobrik\", \"James Charles\",\n","        \"Ryan's World\", \"Jubilee\",\n","    ],\n","    \"News\": [\n","        \"CNN\", \"BBC News\", \"Reuters\", \"PBS NewsHour\", \"Al Jazeera English\",\n","        \"ABC News\", \"Bloomberg Television\", \"FRANCE 24 English\", \"MSNBC\", \"Fox News\",\n","        \"The Guardian\", \"Associated Press\", \"Vox\", \"NowThis News\",\n","        \"Channel 4 News\", \"euronews\",\n","    ],\n","}\n","\n","# ---------- Quota safety ----------\n","# Rough cost per channel: ~100 (search.list to resolve name) + 1 (channels.list)\n","# + ~4 (playlistItems.list, 200 videos @ 50/page) + ~4 (videos.list, 200 @ 50/batch)\n","# ~= 109 units/channel. Budget below leaves headroom for other same-day API use.\n","DAILY_QUOTA_BUDGET = 7500\n","COST_PER_CHANNEL_ESTIMATE = 109\n","\n","VIDEOS_PER_CHANNEL = 200  # match your original sampling depth\n","\n","\n","def resolve_channel_id(name):\n","    \"\"\"Look up a channel by name via the API and return its real ID + confirmed title.\"\"\"\n","    resp = youtube.search().list(part=\"snippet\", q=name, type=\"channel\", maxResults=1).execute()\n","    items = resp.get(\"items\", [])\n","    if not items:\n","        return None, None\n","    return items[0][\"snippet\"][\"channelId\"], items[0][\"snippet\"][\"channelTitle\"]\n","\n","\n","def build_verified_new_channels(names_dict):\n","    \"\"\"Resolve NEW_CHANNEL_NAMES into a {category: [channel_id, ...]} dict,\n","    printing each result so you can eyeball for mismatches before collecting.\n","    Stops early if projected quota use would exceed DAILY_QUOTA_BUDGET.\"\"\"\n","    verified = {}\n","    used_estimate = 0\n","    stopped_early = False\n","\n","    for category, names in names_dict.items():\n","        ids = []\n","        for name in names:\n","            if used_estimate + COST_PER_CHANNEL_ESTIMATE > DAILY_QUOTA_BUDGET:\n","                print(f\"\\n  STOPPING: projected quota use ({used_estimate} units) \"\n","                      f\"would exceed budget ({DAILY_QUOTA_BUDGET}). \"\n","                      f\"Skipping remaining channels.\")\n","                stopped_early = True\n","                break\n","\n","            cid, confirmed = resolve_channel_id(name)\n","            used_estimate += COST_PER_CHANNEL_ESTIMATE\n","            if cid is None:\n","                print(f\"  Could NOT resolve '{name}' -- skipping\")\n","                continue\n","            print(f\"{category:15s} | '{name}' -> {confirmed} ({cid})  \"\n","                  f\"[quota used so far: ~{used_estimate}]\")\n","            ids.append(cid)\n","            time.sleep(0.1)\n","\n","        verified[category] = ids\n","        if stopped_early:\n","            break\n","\n","    print(f\"\\nTotal estimated quota used: ~{used_estimate} / {DAILY_QUOTA_BUDGET} budget\")\n","    return verified\n","\n","\n","def get_uploads_playlist_id(channel_id):\n","    try:\n","        resp = youtube.channels().list(part=\"contentDetails,statistics\", id=channel_id).execute()\n","    except Exception as e:\n","        print(f\"  API ERROR for channel_id={channel_id}: {e}\")\n","        return None, None\n","\n","    items = resp.get(\"items\", [])\n","    if not items:\n","        print(f\"  WARNING: no channel found for id={channel_id} (invalid/fake ID, or channel deleted)\")\n","        print(f\"  Raw response: {resp}\")\n","        return None, None\n","\n","    item = items[0]\n","    uploads_pl = item[\"contentDetails\"][\"relatedPlaylists\"][\"uploads\"]\n","    sub_count = int(item[\"statistics\"].get(\"subscriberCount\", 0))\n","    return uploads_pl, sub_count\n","\n","\n","def get_video_ids_from_playlist(playlist_id, max_videos):\n","    video_ids = []\n","    next_page = None\n","    while len(video_ids) < max_videos:\n","        resp = youtube.playlistItems().list(\n","            part=\"contentDetails\",\n","            playlistId=playlist_id,\n","            maxResults=50,\n","            pageToken=next_page,\n","        ).execute()\n","        video_ids.extend([item[\"contentDetails\"][\"videoId\"] for item in resp[\"items\"]])\n","        next_page = resp.get(\"nextPageToken\")\n","        if not next_page:\n","            break\n","    return video_ids[:max_videos]\n","\n","\n","def batch_video_details(video_ids):\n","    rows = []\n","    for i in range(0, len(video_ids), 50):\n","        batch = video_ids[i:i + 50]\n","        resp = youtube.videos().list(\n","            part=\"snippet,statistics,contentDetails\",\n","            id=\",\".join(batch),\n","        ).execute()\n","        for item in resp[\"items\"]:\n","            snippet = item[\"snippet\"]\n","            stats = item[\"statistics\"]\n","            content = item[\"contentDetails\"]\n","\n","            duration_iso = content.get(\"duration\", \"PT0S\")\n","            try:\n","                duration_seconds = int(isodate.parse_duration(duration_iso).total_seconds())\n","            except Exception:\n","                duration_seconds = None\n","\n","            rows.append({\n","                \"video_id\": item[\"id\"],\n","                \"title\": snippet.get(\"title\", \"\"),\n","                \"channel_title\": snippet.get(\"channelTitle\", \"\"),\n","                \"channel_id\": snippet.get(\"channelId\", \"\"),\n","                \"published_at\": snippet.get(\"publishedAt\", \"\"),\n","                \"view_count\": int(stats.get(\"viewCount\", 0)),\n","                \"like_count\": int(stats.get(\"likeCount\", 0)),\n","                \"comment_count\": int(stats.get(\"commentCount\", 0)),\n","                \"duration_seconds\": duration_seconds,\n","                \"is_short\": (duration_seconds is not None and duration_seconds <= 60),\n","            })\n","        time.sleep(0.1)\n","    return rows\n","\n","\n","def collect(new_channels_dict):\n","    all_rows = []\n","    for category, channel_ids in new_channels_dict.items():\n","        for cid in channel_ids:\n","            print(f\"Collecting {category} / {cid} ...\")\n","            uploads_pl, sub_count = get_uploads_playlist_id(cid)\n","            if uploads_pl is None:\n","                print(f\"  Could not resolve channel {cid}, skipping.\")\n","                continue\n","            video_ids = get_video_ids_from_playlist(uploads_pl, VIDEOS_PER_CHANNEL)\n","            rows = batch_video_details(video_ids)\n","            for r in 